# Copy this file to .env and fill in real values. Never commit the actual .env file.

# Database
DATABASE_URL=postgresql://grihome_user:grihome_pass123@localhost:5432/grihome_db

# JWT Auth
SECRET_KEY=change_this_to_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File uploads
UPLOAD_DIR=uploads

# Tesseract (only needed if tesseract isn't on system PATH)
TESSERACT_CMD=
